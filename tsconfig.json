{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "a11y-lite-wrapper": [
        "src/index.ts"
      ],
      "a11y-lite-wrapper/combobox": [
        "src/combobox/index.ts"
      ],
      "a11y-lite-wrapper/listbox": [
        "src/listbox/index.ts"
      ],
      "a11y-lite-wrapper/keyboard": [
        "src/keyboard/index.ts"
      ],
      "a11y-lite-wrapper/react": [
        "src/react/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
    "demo",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
